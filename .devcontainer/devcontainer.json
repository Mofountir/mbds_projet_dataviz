{
  "name": "MBDS Projet DataViz",
  "dockerComposeFile": "../docker-compose.yaml",
  "service": "app",
  "workspaceFolder": "/app",
  "remoteUser": "app",
  "updateRemoteUserUID": true,
  "overrideCommand": true,
  "shutdownAction": "stopCompose",
  "initializeCommand": [
    "git", "-C", "${localWorkspaceFolder}",
    "-c", "alias.devcontainer-ssh=!sh .devcontainer/initialize-ssh.sh",
    "devcontainer-ssh"
  ],
  "postStartCommand": "uv sync --locked --dev && uv run --no-sync pre-commit install --hook-type pre-commit --config githooks/pre-commit.yaml && uv run --no-sync pre-commit install --hook-type pre-push --config githooks/pre-push.yaml",
  "postAttachCommand": "/bin/sh .devcontainer/check-ssh.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/app/.venv/bin/python"
      }
    }
  }
}
