FROM python:3.13-slim-trixie

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /uvx /usr/local/bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/home/app/.venv \
    UV_CACHE_DIR=/home/app/.cache/uv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PATH="/home/app/.venv/bin:$PATH"

RUN useradd --create-home --shell /bin/bash app \
    && mkdir -p /app \
    && chown app:app /app

WORKDIR /app
USER app

COPY --chown=app:app pyproject.toml uv.lock .python-version README.md ./
RUN uv sync --locked --no-dev --no-install-project

COPY --chown=app:app main.py ./
COPY --chown=app:app src/ ./src/
COPY --chown=app:app .streamlit/config.toml ./.streamlit/config.toml
COPY --chown=app:app data/03_primary/ ./data/03_primary/

RUN uv sync --locked --no-dev

EXPOSE 10000

CMD ["sh", "-c", "exec streamlit run main.py --server.address=0.0.0.0 --server.port=${PORT:-10000}"]